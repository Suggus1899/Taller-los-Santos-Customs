<footer class="mt-auto border-t border-line bg-surface pt-14 pb-6 text-sm text-muted">
  <div class="container-page">
    <div class="grid gap-10 md:grid-cols-[2fr_1fr_1fr_1.5fr]">
      <div>
        <a class="flex items-center gap-2 font-display text-lg font-bold text-fg no-underline hover:text-fg" href="/">
          <span class="grid size-9 place-items-center rounded-lg bg-brand text-white"><%- icon('wrench') %></span>
          <span><%= site.name %></span>
        </a>
        <p class="mt-4 max-w-xs"><%= site.tagline %>.</p>
      </div>

      <nav aria-labelledby="footer-servicios">
        <h2 id="footer-servicios" class="mb-4 font-sans text-sm font-semibold text-fg">Servicios</h2>
        <ul class="grid list-none gap-2 p-0">
          <% services.forEach((service) => { %>
            <li><a class="text-muted no-underline hover:text-fg" href="/servicios/<%= service.slug %>"><%= service.name %></a></li>
          <% }) %>
        </ul>
      </nav>

      <nav aria-labelledby="footer-taller">
        <h2 id="footer-taller" class="mb-4 font-sans text-sm font-semibold text-fg">El taller</h2>
        <ul class="grid list-none gap-2 p-0">
          <li><a class="text-muted no-underline hover:text-fg" href="/nosotros">Nosotros</a></li>
          <li><a class="text-muted no-underline hover:text-fg" href="/garantias">Garantías</a></li>
          <li><a class="text-muted no-underline hover:text-fg" href="/promociones">Promociones</a></li>
          <li><a class="text-muted no-underline hover:text-fg" href="/galeria">Galería</a></li>
          <li><a class="text-muted no-underline hover:text-fg" href="/calculadora-combustible">Calculadora de combustible</a></li>
        </ul>
      </nav>

      <div>
        <h2 class="mb-4 font-sans text-sm font-semibold text-fg">Contacto</h2>
        <%- include('contact-list') %>
      </div>
    </div>

    <% if (officialRate) { %>
      <p class="mt-10 inline-flex items-center gap-2 rounded-full border border-line px-4 py-1.5 text-xs">
        <%- icon('tag', 'size-3.5 text-accent') %>
        Tasa oficial BCV: <strong class="text-fg"><%= bolivares(officialRate.rate) %></strong> por USD · <%= shortDate(officialRate.publishedAt) %>
      </p>
    <% } %>
    <div class="mt-6 flex flex-wrap justify-between gap-3 border-t border-line pt-5 text-xs text-subtle">
      <p>&copy; <%= new Date().getFullYear() %> <%= site.name %>. Todos los derechos reservados.</p>
      <p class="flex gap-4"><a class="text-subtle hover:text-fg" href="/privacidad">Privacidad</a><a class="text-subtle hover:text-fg" href="/admin/login">Acceso del personal</a></p>
    </div>
  </div>
</footer>
