# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.

NODE_ENV=development
PORT=3000
SITE_URL=http://localhost:3000

# PostgreSQL (docker compose up -d levanta uno en localhost:5432)
DATABASE_URL=postgresql://taller:taller@localhost:5432/taller
# Base de datos de los tests: su nombre DEBE terminar en _test (se vacía en cada test)
TEST_DATABASE_URL=postgresql://taller:taller@localhost:5432/taller_test

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Número de proxies delante de la app (1 detrás de Nginx, Render, Railway, etc.).
# Necesario en producción para cookies Secure y para leer la IP real en el rate limit.
TRUST_PROXY=0

# Tasa del dólar (DolarApi). Déjalo vacío para desactivar la consulta externa.
EXCHANGE_RATE_API_URL=https://ve.dolarapi.com/v1/dolares
EXCHANGE_RATE_TTL_MINUTES=30

# Google Analytics 4 (opcional)
GA_MEASUREMENT_ID=

# Notificaciones por correo (opcional: define todas o ninguna)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
