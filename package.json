{
  "name": "taller-los-santos",
  "version": "2.0.0",
  "private": true,
  "description": "Sitio web y panel de gestión de Taller Los Santos (Cagua, Aragua).",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:css": "tailwindcss -i src/styles/main.css -o public/css/main.css --watch",
    "dev:client": "tsc -p tsconfig.client.json --watch",
    "build": "npm run build:css && npm run build:client && npm run build:server",
    "build:css": "tailwindcss -i src/styles/main.css -o public/css/main.css --minify",
    "build:client": "tsc -p tsconfig.client.json",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "create-admin": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dr.pogodin/csurf": "^1.18.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/cli": "^4.3.5",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "effect": "^3.22.5"
  }
}
