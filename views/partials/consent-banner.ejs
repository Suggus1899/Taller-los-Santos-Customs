<%# Banner de consentimiento: formularios normales (funciona sin JavaScript). Solo se muestra si hay analítica configurada. %>
<section class="fixed inset-x-4 bottom-4 z-50 mx-auto max-w-2xl rounded-2xl border border-line-strong bg-surface-2 p-5 shadow-lg shadow-black/50 sm:right-24" aria-labelledby="consent-title">
  <h2 id="consent-title" class="mb-1 font-sans text-base font-semibold">Cookies de analítica</h2>
  <p class="mb-4 text-sm text-muted">Con tu permiso usamos Google Analytics para saber qué páginas se visitan y mejorar el sitio. Las cookies necesarias para que funcionen los formularios se usan siempre. <a href="/privacidad">Más información</a>.</p>
  <div class="flex flex-wrap gap-3">
    <% ['granted', 'denied'].forEach((decision) => { %>
      <form method="post" action="/privacidad/consentimiento">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="decision" value="<%= decision %>">
        <input type="hidden" name="returnTo" value="<%= currentPath %>">
        <button class="btn <%= decision === 'granted' ? 'btn-primary' : 'btn-secondary' %> btn-sm" type="submit"><%= decision === 'granted' ? 'Aceptar' : 'Rechazar' %></button>
      </form>
    <% }) %>
  </div>
</section>
