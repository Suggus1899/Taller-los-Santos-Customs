// Esquema de datos de Taller Los Santos (PostgreSQL).
// Convenciones: modelos en PascalCase y tablas/columnas en snake_case (@@map / @map),
// marcas de tiempo con zona horaria (timestamptz) y dinero en centavos (enteros).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Administración ─────────────────────────────

enum UserRole {
  ADMIN // gestiona todo, incluidos usuarios
  STAFF // gestiona citas, cotizaciones y mensajes

  @@map("user_role")
}

model User {
  id           Int        @id @default(autoincrement())
  /// Se guarda en minúsculas para que el login no distinga mayúsculas.
  username     String     @unique @db.VarChar(64)
  passwordHash String     @map("password_hash")
  displayName  String?    @map("display_name") @db.VarChar(80)
  role         UserRole   @default(STAFF)
  isActive     Boolean    @default(true) @map("is_active")
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  auditLogs    AuditLog[]

  @@map("users")
}

/// Sesiones de express-session (solo se crean al iniciar sesión en el panel).
model Session {
  sid       String   @id @db.VarChar(128)
  data      Json
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("sessions")
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  STATUS_CHANGED
  CREATED
  UPDATED
  DELETED
  PASSWORD_CHANGED
  JOB_RETRIED

  @@map("audit_action")
}

enum AuditEntity {
  USER
  APPOINTMENT
  QUOTE_REQUEST
  CONTACT_MESSAGE
  SERVICE
  PROMOTION
  JOB

  @@map("audit_entity")
}

/// Registro inmutable de acciones del panel (quién cambió qué y cuándo).
model AuditLog {
  id         BigInt      @id @default(autoincrement())
  userId     Int?        @map("user_id")
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType AuditEntity @map("entity_type")
  entityId   Int?        @map("entity_id")
  /// Detalle de la acción, p. ej. { "from": "PENDING", "to": "CONFIRMED" }.
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────── Clientes ────────────────────────────────

/// Persona que contactó al taller. Se identifica por correo (en minúsculas).
model Customer {
  id              Int              @id @default(autoincrement())
  email           String           @unique @db.VarChar(254)
  name            String           @db.VarChar(80)
  phone           String?          @db.VarChar(20)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  vehicles        Vehicle[]
  appointments    Appointment[]
  quoteRequests   QuoteRequest[]
  contactMessages ContactMessage[]

  @@map("customers")
}

enum VehicleType {
  SEDAN
  SUV
  PICKUP
  SPORT

  @@map("vehicle_type")
}

model Vehicle {
  id           Int           @id @default(autoincrement())
  customerId   Int           @map("customer_id")
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Marca, modelo y año tal como los escribió el cliente (p. ej. "Toyota Corolla 2015").
  description  String        @db.VarChar(80)
  type         VehicleType?
  plate        String?       @db.VarChar(12)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  appointments Appointment[]

  @@unique([customerId, description])
  @@map("vehicles")
}

// ──────────────────────────────── Citas ─────────────────────────────────

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

model Appointment {
  id            Int               @id @default(autoincrement())
  /// Identificador público (no secuencial) que se usa en URLs de confirmación.
  publicId      String            @unique @default(uuid()) @map("public_id") @db.Uuid
  customerId    Int               @map("customer_id")
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleId     Int?              @map("vehicle_id")
  vehicle       Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  serviceSlug   String            @map("service_slug") @db.VarChar(60)
  service       Service           @relation(fields: [serviceSlug], references: [slug], onUpdate: Cascade, onDelete: Restrict)
  /// Día de la cita en hora local del taller (America/Caracas).
  scheduledDate DateTime          @map("scheduled_date") @db.Date
  /// Turno "HH:MM" en hora local del taller.
  timeSlot      String            @map("time_slot") @db.Char(5)
  status        AppointmentStatus @default(PENDING)
  notes         String?           @db.VarChar(1000)
  /// Cuándo se envió el recordatorio del día anterior (evita duplicados).
  reminderSentAt DateTime?        @map("reminder_sent_at") @db.Timestamptz(3)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Además existe un índice único PARCIAL (ver migración inicial):
  // uq_appointments_active_slot ON (scheduled_date, time_slot) WHERE status <> 'CANCELLED'
  @@index([scheduledDate, timeSlot])
  @@index([status, scheduledDate])
  @@index([customerId])
  @@map("appointments")
}

// ───────────────────────────── Cotizaciones ─────────────────────────────

enum QuoteStatus {
  NEW
  CONTACTED
  ACCEPTED
  REJECTED
  ARCHIVED

  @@map("quote_status")
}

model QuoteRequest {
  id            Int         @id @default(autoincrement())
  publicId      String      @unique @default(uuid()) @map("public_id") @db.Uuid
  customerId    Int         @map("customer_id")
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicleType   VehicleType @map("vehicle_type")
  /// Códigos de src/content/quote.ts. Se guarda el precio calculado en ese momento
  /// para que un cambio de tarifas no altere cotizaciones ya emitidas.
  serviceCode   String      @map("service_code") @db.VarChar(20)
  extraCode     String      @map("extra_code") @db.VarChar(20)
  estimateCents Int         @map("estimate_cents")
  currency      String      @default("USD") @db.Char(3)
  notes         String?     @db.VarChar(1000)
  status        QuoteStatus @default(NEW)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([customerId])
  @@map("quote_requests")
}

// ─────────────────────────────── Mensajes ────────────────────────────────

enum MessageStatus {
  NEW
  READ
  ARCHIVED

  @@map("message_status")
}

model ContactMessage {
  id         Int           @id @default(autoincrement())
  customerId Int           @map("customer_id")
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  message    String        @db.VarChar(2000)
  status     MessageStatus @default(NEW)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([customerId])
  @@map("contact_messages")
}

// ─────────────────────────── Tasa del dólar ────────────────────────────

enum RateSource {
  OFICIAL // Banco Central de Venezuela (BCV)
  PARALELO

  @@map("rate_source")
}

/// Historial de tasas USD → VES obtenidas del proveedor externo (DolarApi).
/// Sirve de respaldo si el proveedor no responde y permite consultar la evolución.
model ExchangeRate {
  id          Int        @id @default(autoincrement())
  source      RateSource
  /// Bolívares por 1 USD. Decimal para no perder precisión (nunca float con dinero).
  rate        Decimal    @db.Decimal(18, 4)
  /// Fecha de publicación según el proveedor.
  publishedAt DateTime   @map("published_at") @db.Timestamptz(3)
  fetchedAt   DateTime   @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@unique([source, publishedAt])
  @@map("exchange_rates")
}

// ───────────────────────────── Contenido ─────────────────────────────

/// Servicio del catálogo, editable desde el panel. Planes, bloques informativos y
/// preguntas frecuentes son documentos que siempre se leen y escriben junto al
/// servicio, por eso se guardan como JSONB validado con Zod (src/content/schemas.ts).
model Service {
  id           Int           @id @default(autoincrement())
  /// Parte de la URL (/servicios/<slug>). No se edita: las citas lo referencian.
  slug         String        @unique @db.VarChar(60)
  name         String        @db.VarChar(80)
  icon         String        @db.VarChar(30)
  imageKey     String?       @map("image_key") @db.VarChar(30)
  summary      String        @db.VarChar(200)
  intro        String        @db.VarChar(1000)
  plans        Json          @default("[]")
  info         Json          @default("[]")
  faqs         Json          @default("[]")
  isActive     Boolean       @default(true) @map("is_active")
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  appointments Appointment[]

  @@index([isActive, sortOrder])
  @@map("services")
}

model Promotion {
  id            Int       @id @default(autoincrement())
  title         String    @db.VarChar(80)
  description   String    @db.VarChar(300)
  /// Texto del precio tal como se muestra ("$69", "-10 %").
  price         String    @db.VarChar(20)
  previousPrice String?   @map("previous_price") @db.VarChar(20)
  featured      Boolean   @default(false)
  ctaLabel      String    @map("cta_label") @db.VarChar(40)
  ctaHref       String    @map("cta_href") @db.VarChar(200)
  isActive      Boolean   @default(true) @map("is_active")
  sortOrder     Int       @default(0) @map("sort_order")
  /// Ventana de vigencia opcional: fuera de ella no se muestra.
  startsAt      DateTime? @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime? @map("ends_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([isActive, sortOrder])
  @@map("promotions")
}

// ───────────────────────────── Infraestructura ─────────────────────────────

/// Cola de trabajos (patrón outbox): se encola en la MISMA transacción que el dato
/// que la origina, así nunca hay una cita sin su correo ni un correo sin su cita.
/// La procesa el worker (src/worker.ts) con FOR UPDATE SKIP LOCKED.
model Job {
  id          BigInt    @id @default(autoincrement())
  type        String    @db.VarChar(64)
  payload     Json
  runAt       DateTime  @default(now()) @map("run_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  lockedAt    DateTime? @map("locked_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  failedAt    DateTime? @map("failed_at") @db.Timestamptz(3)
  lastError   String?   @map("last_error")
  /// Evita encolar dos veces lo mismo (p. ej. la tarea diaria de un día concreto).
  dedupeKey   String?   @unique @map("dedupe_key") @db.VarChar(120)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  // Además: índice parcial idx_jobs_pending ON (run_at) WHERE pendiente (ver migración).
  @@index([type, createdAt])
  @@map("jobs")
}

/// Contadores del rate limit compartidos entre instancias. Tabla UNLOGGED (ver
/// migración): más rápida y sin WAL; perder los contadores en un fallo es aceptable.
model RateLimit {
  key     String   @id @db.VarChar(200)
  hits    Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("rate_limits")
}
